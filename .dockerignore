# ------------------------------------------------------------
# .dockerignore: Docker build に渡さないファイル
# ビルドコンテキストを小さく保つことで、CI でのビルド時間を短縮し
# 秘密情報の混入も防ぐ
# ------------------------------------------------------------

# Git
.git
.gitignore
.gitattributes
.github

# IDE
.idea
.vscode
*.swp
*.swo
.devcontainer
.claude

# OS
.DS_Store
Thumbs.db

# Laravel ローカル
backend/.env
backend/.env.*
!backend/.env.example
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/framework/testing/*
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore
backend/database/*.sqlite*

# 依存(イメージ側でビルドする)
backend/vendor
backend/node_modules
backend/public/build
backend/public/hot
frontend/node_modules
frontend/.next

# テスト/カバレッジ
backend/.phpunit.cache
backend/coverage
backend/.phpunit.result.cache

# Docker 関連(再帰参照を避ける)
compose.yaml
compose.*.yaml

# ドキュメント・IaC(ビルドに不要)
README.md
README-docker.md
docs
terraform
.terraform

